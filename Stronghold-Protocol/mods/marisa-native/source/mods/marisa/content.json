        "spec": {
          "tiers": [
            {
              "need": "1 distinct",
              "effect": "【罗德岛】干员攻击范围内的其他非【罗德岛】干员获得任何盟约层数 +n 时，rhodeShip 也 +n（不含自己、不含其他【罗德岛】干员）。"
            },
            {
              "need": "1 distinct (always)",
              "effect": "All our units: healing received x(1 + 0.01 * floor(L / 5)); damage-over-time they take is capped at 5 s."
            },
            {
              "need": "1 distinct (on heal)",
              "effect": "A healed unit deals weakness damage (weaknessRetype, items/battle.js) around its 8 tiles: healed * L * 0.1, credited to the healed unit."
            },
            {
              "need": "2 distinct",
              "effect": "Whole-field heal aura every 间隔(L) s; the amount is L; the overflow (amount - missing HP) becomes flat ATK 1:1, capped at 100% of the unit's ATK, dropped after 2 s without overflow."
            },
            {
              "need": "1 distinct (always)",
              "effect": "罗德岛的层数上限 = 已激活的其他盟约中最高的层数（每次加层时现算；没有其他已激活盟约时为 0）。"
            },
            {
              "need": "1 distinct (always)",
              "effect": "叠层效率 = 在场【罗德岛】干员数 × 25%（上限 100%）：1 名 25%、2 名 50%、3 名 75%、4 名及以上 100%。bb.field_eff_per_member / field_eff_max。"
            },
            {
              "need": "4 distinct",
              "effect": "在场 ≥ 4 名不同【罗德岛】干员时，罗德岛干员为此时已触发的主盟约提供在场人数（只计入人数、可把该主盟约顶到更高一档），自身不享受该盟约的加成。bb.field_donate_min。"
            }
          ],
          "formulas": {
            "interval": "interval(L) = 0.5 + (5 - 0.5) * (1 - sqrt(L / 100))",
            "intervalAt": {
              "L0": 5,
              "L100": 0.5
            },
            "healEfficiency": "+1% per full 5 layers",
            "weaknessDamage": "healed * L * 0.1"
          },
          "members": "凯尔希·思衡托 / 阿米娅(医疗) / 华法琳（既有 chess 记录）＋ 自选编队干员：电弧(char_4195_radian) / 可露希尔(char_4228_closur) / 机械师(char_4230_mcnist) / Mon3tr(char_4179_monstr) / 凯尔希(char_003_kalts) —— 后五位的成员身份在 data/backups.json `diy.operators[charId].bonds` 里。",
          "implementedIn": "server/sim/content/bonds/addon/battle.js (buff key MOD_bond_rhode)"
        }
      }
    },
